import os
import shutil
import sys
import argparse

def main():
    parser = argparse.ArgumentParser(
        description="Check WAV file usage across MusE song files (*.med) in a directory."
    )
    parser.add_argument(
        "-d", "--dir",
        default=".",
        help="Target directory to scan (default: current directory)"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Report unused WAV files without moving them"
    )
    parser.add_argument(
        "-y", "--yes", "--non-interactive",
        dest="non_interactive",
        action="store_true",
        help="Run without prompting for user confirmation"
    )

    args = parser.parse_args()
    target_dir = os.path.abspath(args.dir)

    if not os.path.isdir(target_dir):
        print("Error: Target directory '%s' does not exist." % target_dir, file=sys.stderr)
        sys.exit(1)

    print("muse-find-unused-wavs - scanning '%s'..." % target_dir)
    dirlist = os.listdir(target_dir)

    wavs = [f for f in dirlist if f.lower().endswith(".wav")]
    print("====================================================")
    print(" Found %d WAV file(s) in directory." % len(wavs))

    if not wavs:
        print("No WAV files found.")
        sys.exit(0)

    # Scan .med files in directory
    med_files = [f for f in dirlist if f.lower().endswith(".med")]
    print(" Found %d MusE project file(s) (*.med)." % len(med_files))

    used_wavs = set()
    for med_name in med_files:
        med_path = os.path.join(target_dir, med_name)
        try:
            with open(med_path, "r", encoding="utf-8", errors="replace") as med_file:
                content = med_file.read()
                for wav in wavs:
                    if wav in content:
                        used_wavs.add(wav)
        except Exception as e:
            print("Warning: Could not read '%s': %s" % (med_name, e), file=sys.stderr)

    unused_wavs = [w for w in wavs if w not in used_wavs]

    print("====================================================")
    print(" Unused WAV file(s) count: %d" % len(unused_wavs))
    for f in unused_wavs:
        print("   %s" % f)

    if not unused_wavs:
        print("All WAV files are referenced in existing project files.")
        sys.exit(0)

    if args.dry_run:
        print("\nDry-run mode: No files moved.")
        sys.exit(0)

    if not args.non_interactive:
        print("\nMove unused files to 'unused' directory? Press Enter to proceed, or Ctrl+C to cancel.")
        try:
            input()
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            sys.exit(0)

    unused_dir = os.path.join(target_dir, "unused")
    os.makedirs(unused_dir, exist_ok=True)

    for f in unused_wavs:
        src = os.path.join(target_dir, f)
        dst = os.path.join(unused_dir, f)
        shutil.move(src, dst)
        print(" Moved: %s -> %s" % (f, unused_dir))

    print("====================================================")
    print(" Completed cleanly.")

if __name__ == "__main__":
    main()
